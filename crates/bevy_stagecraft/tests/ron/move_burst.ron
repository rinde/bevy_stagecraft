#![enable(implicit_some)]
(
    format_version: 3,
    name: "move burst",
    setup: App(PlainUi),
    steps: [
        // Several pointer moves in one frame, ending over "Pause".
        MoveBurst([(150.0, 50.0), (152.0, 51.0), (154.0, 52.0)]),
        Click(Left),
        Wait(1),
        Check(App(ActivatedOnce)),
    ],
    expect: [App(ActivatedOnce)],
)
