#![enable(implicit_some)]
(
    format_version: 3,
    name: "click pause",
    window_size: (800, 600),
    setup: Named("plain_ui"),
    steps: [
        Glide(target: Text("Pause"), frames: 20),
        Click(Left),
        Wait(1),
        Check(App(ActivatedOnce)),
        Tap(key: KeyP, modifiers: [Ctrl, Shift]),
    ],
    expect: [App(ActivatedOnce)],
)
