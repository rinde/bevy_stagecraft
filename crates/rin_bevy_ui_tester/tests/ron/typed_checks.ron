#![enable(implicit_some)]
(
    format_version: 3,
    name: "typed checks",
    window_size: (800, 600),
    setup: Named("plain_ui"),
    steps: [
        Check(Shows("Pause")),
        Check(Not(Hovered(Text("Pause")))),
        Check(Resource(path: "Activations.0", is: Eq(0))),
        Glide(target: Text("Pause"), frames: 10),
        Check(Hovered(Text("Pause"))),
        Click(Left),
        Wait(1),
        Check(App(Activated(1))),
        Check(App(ActivatedOnce)),
    ],
    expect: [
        App(ActivatedOnce),
        Not(Shows("Resume")),
        Resource(path: "Activations.0", is: Eq(1)),
    ],
)
